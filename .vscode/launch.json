{
    "configurations": [
        {
            "name": "(lldb) 启动",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/src/redis-server",
            "args": ["${workspaceFolder}/redis.conf"],
            "cwd": "${fileDirname}",
            "console": "internalConsole",
            
        }
    ]
}
